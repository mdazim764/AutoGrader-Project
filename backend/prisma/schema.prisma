generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
}

enum Role {
  INSTRUCTOR
  STUDENT
}

enum Status {
  PENDING
  GRADING
  COMPLETED
  FAILED
}

// 1. NEW: Course/Classroom Table
model Course {
  id           String    @id @default(uuid())
  name         String    // e.g., "Design and Analysis of Algorithms"
  code         String    @unique // e.g., "CS5101"
  
  instructorId String
  instructor   User      @relation("CourseInstructor", fields: [instructorId], references: [id])
  
  students     User[]    @relation("CourseStudents") // Enrolled students
  problems     Problem[] // Assignments in this course
  
  createdAt    DateTime  @default(now())
}

// 2. User Table (Updated with Auth & Course Relations)
model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String   // For JWT Auth
  role            Role     @default(STUDENT)
  createdAt       DateTime @default(now())

  // Relations
  coursesTaught   Course[] @relation("CourseInstructor")
  coursesEnrolled Course[] @relation("CourseStudents")
  problems        Problem[]
  submissions     Submission[]
}

// 3. Problem Table (Updated with Course Link)
model Problem {
  id              String   @id @default(uuid())
  title           String   
  statement       String   
  timeLimitSec    Int      @default(1)
  memoryLimitMb   Int      @default(64)
  rules           Json     
  
  instructorId    String
  instructor      User     @relation(fields: [instructorId], references: [id])
  
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id])

  createdAt       DateTime @default(now())
  submissions     Submission[]
}

// 4. Submission Table (THE BIG UPGRADE)
model Submission {
  id              String   @id @default(uuid())
  code            String   
  status          Status   @default(PENDING)
  finalScore      Float?   
  report          Json?    
  
  // 🔥 NEW: Analytics & Plagiarism Engine
  attemptNumber   Int      @default(1)
  isPlagiarized   Boolean  @default(false)
  plagiarismScore Float?   // Percentage e.g., 96.5
  matchedWithId   String?  // ID of the submission it was copied from
  matchedWith     Submission?  @relation("PlagiarismMatch", fields: [matchedWithId], references: [id])
  plagiarismMatches Submission[] @relation("PlagiarismMatch") // Reverse relation for tracking
  
  studentId       String
  student         User     @relation(fields: [studentId], references: [id])
  problemId       String
  problem         Problem  @relation(fields: [problemId], references: [id])
  createdAt       DateTime @default(now())
}